# TRACE project configuration. Non-secret values only (CLAUDE.md rule 6).
# Sourced by every script under infra/. Confirmed 2026-10-11 from Cloud Shell.

GCP_PROJECT=project-66f56fc9-9de6-4cfd-8cf
GCP_PROJECT_NUMBER=616734266046
REGION=us-central1
BQ_LOCATION=us-central1

# Billing is attached (billingEnabled: true on 2026-10-11). Always Free still applies, but nothing stops spend,
# so every query carries maximum_bytes_billed and every resource is approved before creation.
BILLING_ENABLED=true
BQ_MAX_BYTES_BILLED=104857600

# Datasets. TRACE_ENV=dev appends DEV_SUFFIX (BigQuery dataset names cannot contain hyphens, so "_dev", not "-dev").
DS_TARGET=trace_target
DS_LEDGER=trace_ledger
DS_TRUTH=trace_truth
DEV_SUFFIX=_dev

GITHUB_REPO=vaibhavidhumal4/TRACE
ARTIFACT_REPO=trace

# Budget alert. The billing account is in INR, so the "$1" budget is set in INR (about 1 USD; kept slightly low).
BUDGET_AMOUNT_INR=85
BUDGET_AMOUNT_USD=1

# Cloud Run Job names for the target ETL.
ETL_JOB=trace-target-etl
ETL_JOB_DEV=trace-target-etl-dev

# Restricted logging (CLAUDE.md 5.3).
LOG_BUCKET=trace-target-logs
LOG_VIEW=target-only
LOG_SINK=trace-target-sink

# Workload Identity Federation for GitHub Actions. The numeric IDs pin the provider to GITHUB_REPO even if the
# repo or owner is renamed and the old name is re-registered by someone else.
WIF_POOL=github
WIF_PROVIDER=github-actions
GITHUB_REPO_ID=1414002331
GITHUB_OWNER_ID=64737822
